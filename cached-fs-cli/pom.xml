<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.luciferyang</groupId>
    <artifactId>cached-fs-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cached-fs-cli</artifactId>
  <name>cached-fs (cli)</name>
  <description>Operations tooling: inspect, verify-checkpoint, evict.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.luciferyang</groupId>
      <artifactId>cached-fs-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.luciferyang</groupId>
      <artifactId>cached-fs-hadoop</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>
    <!-- Hadoop is `provided` in cached-fs-hadoop because the host application already ships it.
         For the standalone CLI, override the scope to `compile` so the jar runs without an
         externally-supplied hadoop-common on the classpath. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- byte-buddy-agent: parent surefire argLine references the agent jar's path; without the dep
         on the test classpath the property stays as a literal placeholder and the fork fails. -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
